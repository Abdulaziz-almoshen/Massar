          "role": "agent",
          "text": "{\"type\":\"quick_reply\",\"msgid\":\"qr-1786908278447\",\"content\":{\"type\":\"text\",\"text\":\"قبل ما أشرح لك المسار المناسب، هل أنتم منشأة صحية تستخدم نظامًا حاليًا أم مزوّد نظام HIS يخدم منشآت؟\"},\"options\":[{\"title\":\"منشأة صحية\"},{\"title\":\"مزوّد نظام HIS\"}]}"
