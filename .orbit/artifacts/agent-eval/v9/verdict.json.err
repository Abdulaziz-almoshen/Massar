          "text": "{\"type\":\"quick_reply\",\"msgid\":\"qr-1786905969840\",\"content\":{\"type\":\"text\",\"text\":\"أهلًا، أنا المساعد الرقمي لشركة لِين. حتى أوضح لكم المسار المناسب لخدمات التطعيمات، هل أنتم منشأة صحية تستخدم نظامًا، أو مزوّد نظام HIS يخدم منشآت؟\"},\"options\":[{\"title\":\"منشأة صحية\"},{\"title\":\"مزوّد نظام HIS\"}]}"
        },
        {
          "role": "customer",
          "text": "٣ فروع"
        },
        {
          "role": "agent",
          "text": "خدمات التطعيمات تساعد المنشأة على توثيق الجرعات لحظيًا عبر سجل موحّد، مع تنبيهات للجرعات القادمة وتقارير امتثال. وإذا كنتم مزوّد HIS، نقدر ندمج الخدمة داخل رحلة العمل في نظامكم بحيث تدخل المنشآت بيانات أقل وتكمل الإجراء من نفس النظام.\n\nأقدر أرتب لكم مكالمة قصيرة مع المختص لمراجعة الربط أو الاستخدام المناسب لكم. متى يناسبكم؟"
        },
        {
          "role": "customer",
          "text": "نعم نفس النظام"
        },
        {
          "role": "agent",
          "text": "{\"type\":\"quick_reply\",\"msgid\":\"qr-1786905977627\",\"content\":{\"type\":\"text\",\"text\":\"خدمات التطعيمات تساعد المنشأة على توثيق الجرعات لحظيًا عبر سجل موحّد، مع تنبيهات للجرعات القادمة وتقارير امتثال. وإذا كنتم مزوّد HIS، نقدر ندمج الخدمة داخل رحلة العمل في نظامكم بحيث تقل خطوات الإدخال ويكتمل الإجراء من نفس النظام.\\n\\nأقدر أرتب لكم مكالمة قصيرة مع المختص لمراجعة الربط أو الاستخدام المناسب لكم. متى يناسبكم؟\"},\"options\":[{\"title\":\"صباحًا\"},{\"title\":\"بعد الظهر\"},{\"title\":\"مساءً\"}]}"
        }
      ]
