# --- persona
AGENT_NAME=Sara
COMPANY_NAME=Lean

# --- LLM (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG (Weaviate from docker-compose.yml)
KNOWLEDGE_BASE_DIR=knowledge_base
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8088
WEAVIATE_GRPC_PORT=50061
HYBRID_ALPHA=0.5
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
CONTEXTUAL_RETRIEVAL=true

# --- state. Must be database 0: the checkpointer's search index refuses any other db.
REDIS_URL=redis://localhost:6390/0

# --- scoring (JSON; omit to use the blueprint defaults)
# SCORING_WEIGHTS={"budget_match":3,"timeline_urgency":2,"pain_point_clarity":2,"decision_maker_authority":2,"engagement_velocity":1.5,"question_depth":1}
# THRESHOLDS={"HOT":8,"WARM":5,"COLD":0}

# --- messaging: cloud_api | gupshup
WHATSAPP_PROVIDER=cloud_api
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_WEBHOOK_TOKEN=
REENGAGE_TEMPLATE_NAME=
REENGAGE_TEMPLATE_LANGUAGE=ar
DRIP_TEMPLATE_NAME=

# --- send safety: nothing is delivered unless enabled, and then only to the allowlist
WHATSAPP_SEND_ENABLED=false
SEND_ALLOWLIST=
ALLOW_ALL_RECIPIENTS=false

# --- escalation / CRM
CRM_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# --- admin (ack / release endpoints)
ADMIN_TOKEN=

# --- PDPL data minimisation
DATA_RETENTION_DAYS=90
