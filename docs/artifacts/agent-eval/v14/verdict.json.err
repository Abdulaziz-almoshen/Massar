          "role": "customer",
          "text": "نبغى نربط سجل التطعيمات"
        },
        {
          "role": "agent",
          "text": "{\"type\":\"quick_reply\",\"msgid\":\"qr-1786938459050\",\"content\":{\"type\":\"text\",\"text\":\"أنا المساعد الرقمي لشركة لِين. هل تمثلون منشأة صحية تستخدم نظامًا حاليًا، أم مزوّد نظام HIS يخدم منشآت؟\"},\"options\":[{\"title\":\"منشأة صحية\"},{\"title\":\"مزوّد نظام HIS\"}]}"
        },
