          "role": "customer",
          "text": "٣ فروع"
        },
        {
          "role": "agent",
          "text": "{\"type\":\"quick_reply\",\"msgid\":\"qr-1786938462405\",\"content\":{\"type\":\"text\",\"text\":\"سواء كنتم منشأة صحية أو مزوّد HIS، نقدر نخلي توثيق التطعيمات يتم من داخل النظام بدل التنقّل وإعادة إدخال البيانات. للمنشأة هذا يسرّع عمل الممارسين، ولمزوّد النظام يضيف رحلة تطعيمات متكاملة لعملائه.\\n\\nأقدر أرتب لكم مكالمة قصيرة مع المختص لمراجعة الربط المناسب.\"},\"options\":[{\"title\":\"صباحًا\"},{\"title\":\"بعد الظهر\"},{\"title\":\"مساءً\"}]}"
        },
        {
          "role": "customer",
          "text": "نعم نفس النظام"
        },
        {
          "role": "agent",
          "text": "{\"type\":\"quick_reply\",\"msgid\":\"qr-1786938465165\",\"content\":{\"type\":\"text\",\"text\":\"سواء كنتم منشأة صحية أو مزوّد HIS، نقدر نخلي توثيق التطعيمات يتم من داخل النظام بدل التنقّل وإعادة إدخال البيانات. للمنشأة هذا يسرّع عمل الممارسين، ولمزوّد النظام يضيف رحلة تطعيمات متكاملة لعملائه.\\n\\nأقدر أرتب لكم مكالمة قصيرة مع المختص لمراجعة الربط المناسب.\"},\"options\":[{\"title\":\"صباحًا\"},{\"title\":\"بعد الظهر\"},{\"title\":\"مساءً\"}]}"
        }
      ]
